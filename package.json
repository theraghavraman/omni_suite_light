{
  "name": "@theraghavraman/omni-universal-data-studio",
  "productName": "OmniConverter Studio",
  "version": "1.0.0",
  "description": "Browser-first universal data, signal, scientific, schema, SQL, image, audio, and archive helper library plus standalone Electron desktop application for OmniConverter Studio.",
  "license": "MIT",
  "main": "electron/main.cjs",
  "exports": {
    ".": "./universal_data_studio.js"
  },
  "files": [
    "universal_data_studio.js",
    "README.npm.md",
    "LICENSE"
  ],
  "config": {
    "forge": "./electron/forge.config.cjs"
  },
  "scripts": {
    "postinstall": "node .github/scripts/apply_desktop_patches.cjs",
    "desktop:stage": "node scripts/desktop_build.cjs stage",
    "desktop:start": "electron-forge start",
    "desktop:package": "node scripts/desktop_build.cjs package",
    "desktop:make": "node scripts/desktop_build.cjs make",
    "desktop:verify": "python3 -m unittest discover -s tests -v && python3 .github/scripts/omni_contract_audit.py && python3 .github/scripts/environment_inventory_test.py",
    "desktop:smoke": "node scripts/desktop_build.cjs smoke"
  },
  "keywords": [
    "omni",
    "data-conversion",
    "csv",
    "json",
    "yaml",
    "sql",
    "schema",
    "parquet",
    "scientific-data",
    "electron"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theraghavraman/omni_suite_light.git"
  },
  "homepage": "https://theraghavraman.github.io/omni_suite_light/",
  "bugs": {
    "url": "https://github.com/theraghavraman/omni_suite_light/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "electron": "^45.2.3",
    "patch-package": "^8.0.1"
  },
  "overrides": {
    "glob@>=9.0.0 <14.0.2": "14.0.4",
    "minimatch@>=7.0.0 <11.0.1": "11.0.5",
    "appdmg": {
      "image-size": "2.1.0"
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.4": true,
    "fs-xattr@0.3.1": true,
    "macos-alias@0.2.12": true
  }
}
