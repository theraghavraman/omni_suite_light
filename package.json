{
  "name": "@theraghavraman/omni-universal-data-studio",
  "productName": "OmniConverter Studio",
  "version": "1.0.0",
  "description": "Browser-first universal data, signal, scientific, schema, SQL, image, audio, and archive helper library plus standalone Electron desktop application for OmniConverter Studio.",
  "license": "MIT",
  "main": "electron/main.cjs",
  "exports": {
    ".": "./universal_data_studio.js"
  },
  "files": [
    "universal_data_studio.js",
    "README.npm.md",
    "LICENSE"
  ],
  "config": {
    "forge": "./electron/forge.config.cjs"
  },
  "scripts": {
    "desktop:stage": "python3 scripts/stage_desktop_bundle.py",
    "desktop:start": "electron-forge start",
    "desktop:package": "python3 scripts/stage_desktop_bundle.py && electron-forge package",
    "desktop:make": "python3 scripts/stage_desktop_bundle.py && electron-forge make",
    "desktop:verify": "python3 -m unittest discover -s tests -v && python3 .github/scripts/omni_contract_audit.py && python3 .github/scripts/environment_inventory_test.py"
  },
  "keywords": [
    "omni",
    "data-conversion",
    "csv",
    "json",
    "yaml",
    "sql",
    "schema",
    "parquet",
    "scientific-data",
    "electron"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theraghavraman/omni_suite_light.git"
  },
  "homepage": "https://theraghavraman.github.io/omni_suite_light/",
  "bugs": {
    "url": "https://github.com/theraghavraman/omni_suite_light/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.6.0",
    "@electron-forge/maker-deb": "^7.6.0",
    "@electron-forge/maker-dmg": "^7.6.0",
    "@electron-forge/maker-rpm": "^7.6.0",
    "@electron-forge/maker-squirrel": "^7.6.0",
    "@electron-forge/maker-zip": "^7.6.0",
    "electron": "^34.2.0"
  }
}
